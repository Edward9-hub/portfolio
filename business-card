* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background-color: rosybrown;
  color: #242824;
  font-family: Arial, sans-serif;
}

.business-card {
  width: 300px;
  max-width: calc(100% - 32px);
  margin-top: 100px;
  margin-right: auto;
  margin-left: auto;
  padding: 20px;
  background-color: #fffdf6;
  border-top: 5px solid #305747;
  box-shadow: 8px 8px 0 rgba(53, 48, 41, 0.18);
  text-align: center;
  font-size: 16px;
}

.profile-image {
  display: block;
  max-width: 100%;
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  margin: 0 auto 16px;
}

p {
  margin: 5px 0;
}

.full-name {
  color: #305747;
  font-size: 22px;
  font-weight: 700;
}

.designation {
  font-weight: 700;
}

.company {
  color: #62685f;
}

hr {
  border: 0;
  border-top: 1px solid #d5d4c8;
  margin: 16px 0;
}

a {
  color: #305747;
  text-decoration: none;
}

a:hover,
a:focus-visible {
  color: #a34a3c;
}

a:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 3px;
}

.portfolio-link {
  display: inline-block;
  margin-top: 5px;
  font-weight: 700;
}

.social-media h2 {
  margin: 0 0 12px;
  color: #305747;
  font-size: 17px;
}

.social-media a {
  display: inline-block;
  margin: 0 5px;
  font-size: 14px;
  font-weight: 700;
}
